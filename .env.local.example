GEMINI_API_KEY=            # from aistudio.google.com/apikey (free)
GEMINI_MODEL=gemini-flash-lite-latest   # fast + reliable; gemini-flash-latest also works but is
                                         # much slower and prone to "high demand" 503s on the free tier
GROQ_API_KEY=              # from console.groq.com (free, optional fallback)
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PRIMARY=gemini         # gemini | groq
DEMO_MODE=false            # true = never call LLM; use seeds + templates only
